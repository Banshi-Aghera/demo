rules_version = '2';

// Rules for Phases 1-3. Later phases add slots, lending, deals, wallets.
// Orders, payments, reviews and notifications are written only by Cloud
// Functions (Admin SDK bypasses these rules), so clients can't fake them.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Admins list users from the panel; role/block changes still go
      // through the adminSetUserFlags function.
      allow list: if isAdmin();

      // A new user can only create their own profile, always as a customer.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.blocked == false;

      // Users can edit their own profile but never their role or blocked flag.
      allow update: if (signedIn()
          && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'blocked', 'uid']))
        || isAdmin();

      allow delete: if isAdmin();
    }

    match /societies/{societyId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // One membership document per user, id = user uid.
    match /societyMemberships/{uid} {
      allow read, list: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Users can request (or re-request) membership, but only as "pending".
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.userId == uid
        && request.resource.data.status == 'pending';

      allow create, update, delete: if isAdmin();
    }
    match /groupDeals/{dealId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
    }
  
    // ---------- Catalog (Phase 2): anyone signed in reads, admins write ----------
    match /products/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Created by the submitReview function (verified purchase only).
    match /reviews/{id} {
      allow read: if signedIn();
      allow delete: if isAdmin();
    }
    // Look up a known code only; listing all coupons is not allowed.
    match /coupons/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
    match /appSettings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- Personal data: only the owner ----------
    match /carts/{uid}/items/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /wishlists/{uid}/items/{productId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/addresses/{addressId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/fcmTokens/{token} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- Orders (Phase 3): read-only for the owner ----------
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /counters/{id} {
      allow read, write: if false;
    }

    // Dashboard aggregates: written by Cloud Functions only.
    match /dailyStats/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Owners may only flip "read" on their own notifications.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
  }
}
